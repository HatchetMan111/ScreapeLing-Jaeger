[Unit]
Description=ScrapJaeger - lokales Scrapling-Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scrapjaeger
WorkingDirectory=/opt/scrapjaeger/app
EnvironmentFile=/opt/scrapjaeger/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/scrapjaeger/ms-playwright
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/scrapjaeger/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8091 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
